{
  "name": "forger-desktop",
  "version": "0.5.16",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Desktop launcher for Forger",
  "author": "Forger",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "fresh-dev": "node ./scripts/fresh-dev.mjs",
    "dev:reset-state": "node ./scripts/reset-dev-state.mjs",
    "prepare:docs": "node ./scripts/prepare-forger-docs.mjs",
    "dev:renderer": "npm run prepare:docs && vite",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist-electron/main/index.js dist-electron/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "prepare:app-skeleton": "node ./scripts/prepare-app-skeleton-resource.mjs",
    "build": "npm run prepare:app-skeleton && npm run build:renderer && npm run build:electron",
    "build:renderer": "npm run prepare:docs && vite build",
    "clean:electron": "node ./scripts/clean-electron-build.mjs",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json",
    "typecheck": "npm run prepare:docs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "npm run prepare:docs && eslint .",
    "test": "npm run test:electron && npm run test:renderer",
    "test:electron": "npm run build:electron && npm run test:electron:built",
    "test:electron:built": "node --test test/contracts/*.test.mjs test/main/*.test.mjs scripts/test-automation-approval-policy.mjs scripts/test-app-agent-runtime-contract.mjs",
    "test:electron:focused": "npm run build:electron && npm run test:electron:focused:built",
    "test:electron:focused:built": "node --test test/contracts/desktop-release-artifacts.test.mjs test/contracts/ipc-contract.test.mjs test/main/backups-platform-security.test.mjs test/main/manifest-support-behavior.test.mjs test/main/preload-bridge.test.mjs test/main/runtime-open-process-behavior.test.mjs test/main/trusted-ipc.test.mjs test/main/window-ipc-and-bootstrap.test.mjs",
    "test:contracts": "npm run test:electron",
    "test:renderer": "vitest run",
    "test:e2e": "npm run build:renderer && npm run build:electron && npm run test:e2e:built",
    "test:e2e:built": "playwright test --config=playwright.config.ts",
    "test:resources": "python -m unittest discover -s test/resources -p '*_test.py'",
    "test:coverage": "npm run test:coverage:electron:strict && npm run test:coverage:renderer",
    "test:coverage:electron:report": "npm run build:electron && c8 --reporter=text node --test --test-force-exit test/contracts/*.test.mjs test/main/*.test.mjs scripts/test-automation-approval-policy.mjs scripts/test-app-agent-runtime-contract.mjs",
    "test:coverage:electron:strict": "npm run build:electron && c8 --check-coverage --lines=88 --statements=88 --branches=83 --functions=89 --reporter=text node --test --test-force-exit test/contracts/*.test.mjs test/main/*.test.mjs scripts/test-automation-approval-policy.mjs scripts/test-app-agent-runtime-contract.mjs",
    "test:coverage:renderer": "vitest run --coverage",
    "test:automation-approval": "npm run build:electron && node ./scripts/test-automation-approval-policy.mjs",
    "test:app-agent-runtime-contract": "npm run build:electron && node ./scripts/test-app-agent-runtime-contract.mjs",
    "dist:mac": "npm run build && npm run dist:mac:built",
    "dist:mac:built": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "release:ci:mac": "node ./scripts/release-local.mjs --platform=mac --wait-notarize --skip-publish",
    "dist:win": "npm run build && npm run dist:win:built",
    "dist:win:built": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && npm run dist:linux:built",
    "dist:linux:built": "electron-builder --linux deb --x64 --publish never",
    "release:local": "node ./scripts/release-local.mjs",
    "release:local:mac": "node ./scripts/release-local.mjs --platform=mac",
    "release:local:mac:wait": "node ./scripts/release-local.mjs --platform=mac --wait-notarize",
    "release:local:win": "node ./scripts/release-local.mjs --platform=win",
    "release:local:linux": "node ./scripts/release-local.mjs --platform=linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/poppins": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "@xyflow/react": "^12.11.1",
    "better-sqlite3": "^12.9.0",
    "bonjour-service": "^1.4.3",
    "cross-spawn": "^7.0.6",
    "flag-icons": "^7.5.0",
    "i18n-iso-countries": "^7.14.0",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serialport": "^13.0.0",
    "simple-icons": "^16.25.0",
    "tslib": "^2.8.1",
    "ws": "^8.18.3",
    "yauzl": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^11.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "ai.forger.desktop",
    "productName": "Forger",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/main/prompt-builder/prompts",
        "to": "prompt-builder/prompts",
        "filter": [
          "**/*.md",
          "**/*.py",
          "**/*.csv",
          "**/*.txt"
        ]
      },
      {
        "from": "resources/speech-to-text",
        "to": "speech-to-text",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/text-to-speech",
        "to": "text-to-speech",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/app-skeletons/vite-fastapi-sqlite",
        "to": "app-skeletons/vite-fastapi-sqlite",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.gitmodules",
          "!**/.idea/**",
          "!**/node_modules/**",
          "!**/.venv/**",
          "!**/dist/**",
          "!**/build/**",
          "!**/coverage/**",
          "!**/__pycache__/**",
          "!**/.DS_Store",
          "!**/.pytest_cache/**",
          "!**/.ruff_cache/**"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@serialport/**/*",
      "node_modules/serialport/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Forger uses the microphone only when you start voice recording or live transcription.",
        "NSAudioCaptureUsageDescription": "Forger captures audio only when you start a visible recording, live transcription, or system audio workflow."
      },
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "forger-desktop-macos-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "forger-desktop-windows-x64.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Forger <hello@forger.cloud>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "forger-desktop-linux-x64.${ext}"
    }
  }
}
